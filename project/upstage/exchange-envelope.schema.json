        "location_or_side_raw",
        "prop_raw",
        "costume_state_raw",
        "duration_raw",
        "cumulative_time_raw",
        "timing_qualifier_raw",
        "comment_marker_raw",
        "unresolved_marker_raw"
      ],
      "properties": {
        "fact_kind": {"type": "string"},
        "document_label_raw": {"type": "string"},
        "section_marker_raw": {"type": "string"},
        "section_title_raw": {"type": "string"},
        "speaker_raw": {"type": "string"},
        "dialogue_line_raw": {"type": "string"},
        "stage_direction_raw": {"type": "string"},
        "character_or_subject_raw": {"type": "string"},
        "performer_raw": {"type": "string"},
        "role_or_alias_raw": {"type": "string"},
        "movement_or_presence_raw": {"type": "string"},
        "location_or_side_raw": {"type": "string"},
        "prop_raw": {"type": "string"},
        "costume_state_raw": {"type": "string"},
