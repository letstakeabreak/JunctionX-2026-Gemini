        "unresolved_marker_raw",
        "note_raw"
      ],
      "properties": {
        "record_kind": {"type": "string"},
        "department_cue_id_raw": {"type": "string"},
        "trigger_raw": {"type": "string"},
        "target_raw": {"type": "string"},
        "operation_raw": {"type": "string"},
        "state_raw": {"type": "string"},
        "location_raw": {"type": "string"},
        "prop_raw": {"type": "string"},
        "costume_raw": {"type": "string"},
        "responsible_party_raw": {"type": "string"},
        "duration_raw": {"type": "string"},
