{
  "buildCommand": "cd server && npm ci && npm run build && cd ../app && npm ci && npm run build",
  "outputDirectory": "app/dist",
  "rewrites": [
    { "source": "/v1/(.*)", "destination": "/api/index.js" },
    { "source": "/healthz", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
